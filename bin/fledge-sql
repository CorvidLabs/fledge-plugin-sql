#!/usr/bin/env bash
set -euo pipefail

# Save original stdout for protocol messages; command substitutions
# capture stdout, so protocol writes must go to fd3 to reach the host.
exec 3>&1

# --- fledge-v1 protocol helpers ---

send() { printf '%s\n' "$1" >&3; }

recv() {
  local line
  if ! IFS= read -r line; then
    exit 0
  fi
  printf '%s\n' "$line"
}

json_obj() { jq -cn "$@"; }

send_output() { local nl=$'\n'; send "$(json_obj --arg t "$1$nl" '{type:"output",text:$t}')"; }
send_log() { send "$(json_obj --arg l "$1" --arg m "$2" '{type:"log",level:$l,message:$m}')"; }
send_error() { send_log "error" "$1"; }

send_exec() {
  local id="$1" cmd="$2" cwd="${3:-}"
  if [ -n "$cwd" ]; then
    send "$(json_obj --arg id "$id" --arg cmd "$cmd" --arg cwd "$cwd" '{type:"exec",id:$id,command:$cmd,cwd:$cwd}')"
  else
    send "$(json_obj --arg id "$id" --arg cmd "$cmd" '{type:"exec",id:$id,command:$cmd}')"
  fi
  recv
}

send_store() {
  local key="$1" value="$2"
  send "$(json_obj --arg k "$key" --arg v "$value" '{type:"store",key:$k,value:$v}')"
}

send_load() {
  local id="$1" key="$2"
  send "$(json_obj --arg id "$id" --arg k "$key" '{type:"load",id:$id,key:$k}')"
  recv
}

send_prompt() {
  local id="$1" message="$2" default="${3:-}"
  if [ -n "$default" ]; then
    send "$(json_obj --arg id "$id" --arg m "$message" --arg d "$default" '{type:"prompt",id:$id,message:$m,default:$d}')"
  else
    send "$(json_obj --arg id "$id" --arg m "$message" '{type:"prompt",id:$id,message:$m}')"
  fi
  recv
}

# --- Response parsing helpers ---

resp_stdout() { printf '%s' "$1" | jq -r '.value.stdout // ""' 2>/dev/null; }
resp_stderr() { printf '%s' "$1" | jq -r '.value.stderr // ""' 2>/dev/null; }
resp_code() { printf '%s' "$1" | jq -r '.value.code // 0' 2>/dev/null; }
resp_value() { printf '%s' "$1" | jq -r '.value // empty' 2>/dev/null; }

# --- Validate dependencies ---

command -v jq >/dev/null 2>&1 || { printf '{"type":"log","level":"error","message":"jq not found — install jq before using fledge-plugin-sql"}\n' >&3; exit 1; }
command -v sqlite3 >/dev/null 2>&1 || { send_error "sqlite3 not found — install SQLite before using fledge-plugin-sql"; exit 1; }

# --- Parse init message ---

INIT=$(recv)
ARGS=$(printf '%s' "$INIT" | jq -r '.args // [] | .[]' 2>/dev/null)
PROJECT_ROOT=$(printf '%s' "$INIT" | jq -r '.project.root // "."' 2>/dev/null)

declare -a ARGV=()
while IFS= read -r arg; do
  [ -n "$arg" ] && ARGV+=("$arg")
done <<< "$ARGS"

SUBCMD="${ARGV[0]:-help}"

# --- Helper: get DB path from store ---

get_db_path() {
  local resp
  resp=$(send_load "load-db" "db_path")
  local val
  val=$(resp_value "$resp")
  if [ -n "$val" ]; then
    printf '%s' "$val"
  fi
}

# --- Subcommands ---

cmd_init() {
  local db_path=""

  local i=1
  while [ $i -lt ${#ARGV[@]} ]; do
    case "${ARGV[$i]}" in
      --path)
        i=$((i + 1))
        db_path="${ARGV[$i]:-}"
        ;;
    esac
    i=$((i + 1))
  done

  if [ -z "$db_path" ]; then
    local resp
    resp=$(send_prompt "prompt-path" "Database path:" ".fledge/data.db")
    db_path=$(resp_value "$resp")
  fi

  if [[ "$db_path" != /* ]]; then
    db_path="$PROJECT_ROOT/$db_path"
  fi

  local check
  check=$(send_exec "check-exists" "test -f '$db_path' && echo exists || echo missing" "$PROJECT_ROOT")
  local exists
  exists=$(resp_stdout "$check" | tr -d '[:space:]')

  if [ "$exists" = "exists" ]; then
    send_output "Database already exists at $db_path"
    send_store "db_path" "$db_path"
    exit 0
  fi

  local dir
  dir=$(dirname "$db_path")
  local mkdir_resp
  mkdir_resp=$(send_exec "mkdir" "mkdir -p '$dir'" "$PROJECT_ROOT")
  local mkdir_code
  mkdir_code=$(resp_code "$mkdir_resp")
  if [ "$mkdir_code" != "0" ]; then
    local mkdir_err
    mkdir_err=$(resp_stderr "$mkdir_resp")
    send_error "Failed to create directory $dir: $mkdir_err"
    exit 1
  fi
  send_exec "create-db" "sqlite3 '$db_path' 'SELECT 1;'" "$PROJECT_ROOT" > /dev/null
  send_store "db_path" "$db_path"
  send_output "Created database at $db_path"
}

cmd_migrate() {
  local db_path
  db_path=$(get_db_path)
  if [ -z "$db_path" ]; then
    send_error "No database initialized. Run: fledge sql init"
    exit 1
  fi

  local migrations_dir="$PROJECT_ROOT/migrations"

  local i=1
  while [ $i -lt ${#ARGV[@]} ]; do
    case "${ARGV[$i]}" in
      --dir)
        i=$((i + 1))
        migrations_dir="${ARGV[$i]:-}"
        if [[ "$migrations_dir" != /* ]]; then
          migrations_dir="$PROJECT_ROOT/$migrations_dir"
        fi
        ;;
    esac
    i=$((i + 1))
  done

  local check
  check=$(send_exec "check-dir" "test -d '$migrations_dir' && echo exists || echo missing" "$PROJECT_ROOT")
  local exists
  exists=$(resp_stdout "$check" | tr -d '[:space:]')

  if [ "$exists" != "exists" ]; then
    send_output "No migrations directory found at $migrations_dir"
    exit 0
  fi

  send_exec "create-meta" "sqlite3 '$db_path' 'CREATE TABLE IF NOT EXISTS _migrations (id INTEGER PRIMARY KEY, filename TEXT UNIQUE, applied_at TEXT);'" "$PROJECT_ROOT" > /dev/null

  local files_resp
  files_resp=$(send_exec "list-files" "find '$migrations_dir' -maxdepth 1 -name '*.sql' -print0 2>/dev/null | sort -z | tr '\\0' '\\n'" "$PROJECT_ROOT")
  local files
  files=$(resp_stdout "$files_resp")

  if [ -z "$files" ]; then
    send_output "No .sql migration files found."
    exit 0
  fi

  local applied=0
  while IFS= read -r filepath <&4; do
    [ -z "$filepath" ] && continue
    local filename
    filename=$(basename "$filepath")

    local safe_filename
    safe_filename=$(printf '%s' "$filename" | sed "s/'/''/g")

    local already
    already=$(send_exec "check-$filename" "printf '%s' 'SELECT COUNT(*) FROM _migrations WHERE filename='\''${safe_filename}'\'';' | sqlite3 '$db_path'" "$PROJECT_ROOT")
    local count
    count=$(resp_stdout "$already" | tr -d '[:space:]')

    if [ "$count" != "0" ]; then
      continue
    fi

    # Wrap each migration + its tracking row in a single transaction so a
    # partial failure cleanly rolls back. `-bail` aborts on first error;
    # since COMMIT never runs, sqlite3's auto-rollback-on-close kicks in.
    local result
    result=$(send_exec "apply-$filename" "(printf '%s' 'BEGIN;'; cat '$filepath'; printf '%s' 'INSERT INTO _migrations (filename, applied_at) VALUES ('\''${safe_filename}'\'', datetime('\''now'\''));COMMIT;') | sqlite3 -bail '$db_path'" "$PROJECT_ROOT")
    local exit_code
    exit_code=$(resp_code "$result")

    if [ "$exit_code" != "0" ]; then
      local stderr
      stderr=$(resp_stderr "$result")
      send_error "Migration failed: $filename — $stderr"
      exit 1
    fi

    send_output "  Applied: $filename"
    applied=$((applied + 1))
  done 4<<< "$files"

  if [ "$applied" -eq 0 ]; then
    send_output "All migrations already applied."
  else
    send_output "Applied $applied migration(s)."
  fi
}

cmd_query() {
  local db_path=""
  local format="column"
  local allow_destructive=0
  local sql_parts=()
  local param_names=()
  local param_values=()
  local i=1
  while [ $i -lt ${#ARGV[@]} ]; do
    case "${ARGV[$i]}" in
      --path) i=$((i + 1)); db_path="${ARGV[$i]:-}" ;;
      --list) format="list" ;;
      --csv) format="csv" ;;
      --json) format="json" ;;
      --allow-destructive) allow_destructive=1 ;;
      --param)
        i=$((i + 1))
        local kv="${ARGV[$i]:-}"
        local pname="${kv%%=*}"
        local pval="${kv#*=}"
        if [ -z "$pname" ] || [ "$pname" = "$kv" ]; then
          send_error "Bad --param syntax: expected name=value, got '$kv'"
          exit 1
        fi
        # Allow @name or :name; normalize to @name (sqlite3 supports both).
        case "$pname" in
          @*|:*) ;;
          *) pname="@$pname" ;;
        esac
        # Strict name validation — anything else lets a malicious
        # caller embed SQL after the @.
        if ! [[ "${pname#[@:]}" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]; then
          send_error "Bad --param name: '$pname' (must match [A-Za-z_][A-Za-z0-9_]*)"
          exit 1
        fi
        param_names+=("$pname")
        param_values+=("$pval")
        ;;
      *) sql_parts+=("${ARGV[$i]}") ;;
    esac
    i=$((i + 1))
  done

  if [ -z "$db_path" ]; then
    db_path=$(get_db_path)
  elif [[ "$db_path" != /* ]]; then
    db_path="$PROJECT_ROOT/$db_path"
  fi
  if [ -z "$db_path" ]; then
    send_error "No database initialized. Run: fledge sql init"
    exit 1
  fi

  local sql="${sql_parts[*]+${sql_parts[*]}}"
  if [ -z "$sql" ]; then
    send_error "Usage: fledge sql query [--list|--csv|--json] [--allow-destructive] [--param name=value]... <sql>"
    exit 1
  fi

  # Safety: block multi-statement queries (multiple semicolon-separated statements).
  # Strip trailing whitespace/semicolons, then check for interior semicolons.
  local trimmed
  trimmed=$(printf '%s' "$sql" | sed 's/[[:space:];]*$//')
  if printf '%s' "$trimmed" | grep -q ';'; then
    send_error "Multi-statement queries are not supported for safety. Run each statement separately."
    exit 1
  fi

  # Safety: block destructive DDL unless --allow-destructive is passed.
  if [ "$allow_destructive" -eq 0 ]; then
    local upper_sql
    upper_sql=$(printf '%s' "$sql" | tr '[:lower:]' '[:upper:]')
    if printf '%s' "$upper_sql" | grep -qE '(^|[[:space:]])(DROP|ALTER|TRUNCATE)[[:space:]]'; then
      send_error "Destructive operation blocked. Use --allow-destructive to override."
      exit 1
    fi
  fi

  local sqlite_flags
  case "$format" in
    json) sqlite_flags="-json" ;;
    list) sqlite_flags="-list -separator '|'" ;;
    csv) sqlite_flags="-csv -header" ;;
    *) sqlite_flags="-header -column" ;;
  esac

  # Build sqlite3 input. If params are present, prefix with .parameter
  # init and one .parameter set per binding — values are encoded as a
  # hex BLOB and concatenated with an empty string to coerce to TEXT.
  # This is the only sqlite3 CLI .parameter set form that handles
  # arbitrary content (single quotes, double quotes, newlines, NULs)
  # correctly — the CLI's whitespace tokenizer doesn't parse SQL string
  # literals robustly, but hex blobs contain only [0-9a-f] and avoid
  # every quoting hazard. Untrusted values can't inject SQL no matter
  # what the user writes in the surrounding query.
  local sqlite_input=""
  if [ "${#param_names[@]}" -gt 0 ]; then
    sqlite_input=".parameter init"$'\n'
    local j=0
    while [ "$j" -lt "${#param_names[@]}" ]; do
      local pn="${param_names[$j]}"
      local pv="${param_values[$j]}"
      local hex
      hex=$(printf '%s' "$pv" | od -A n -t x1 | tr -d ' \n')
      sqlite_input+=".parameter set ${pn} x'${hex}'||''"$'\n'
      j=$((j + 1))
    done
  fi
  # Detect DML so we can query changes() in the same session.
  local is_dml=0
  local upper_sql_type
  upper_sql_type=$(printf '%s' "$sql" | sed 's/^[[:space:]]*//' | tr '[:lower:]' '[:upper:]')
  case "$upper_sql_type" in
    INSERT*|UPDATE*|DELETE*) is_dml=1 ;;
  esac

  # For DML, append SELECT changes() to the same sqlite3 input so the
  # row-count is captured in the same connection. The semicolon is safe
  # here — the multi-statement guard already validated the *user* SQL.
  if [ "$is_dml" -eq 1 ]; then
    sqlite_input+="${sql}; SELECT changes();"
  else
    sqlite_input+="$sql"
  fi

  local result
  local safe_input
  safe_input=$(printf '%q' "$sqlite_input")
  result=$(send_exec "query" "printf '%s' $safe_input | sqlite3 $sqlite_flags '$db_path'" "$PROJECT_ROOT")
  local exit_code
  exit_code=$(resp_code "$result")

  if [ "$exit_code" != "0" ]; then
    local stderr
    stderr=$(resp_stderr "$result")
    send_error "Query failed: $stderr"
    exit 1
  fi

  local stdout
  stdout=$(resp_stdout "$result")

  if [ "$is_dml" -eq 1 ]; then
    # The last line of output is the changes() count. For -json mode
    # it is a JSON array like [{"changes()":1}]; for default mode it
    # is just a plain number. Extract the numeric value either way.
    local changes_n
    changes_n=$(printf '%s' "$stdout" | grep -oE '[0-9]+' | tail -1)
    changes_n="${changes_n:-0}"
    send_output "{\"ok\":true,\"changes\":$changes_n}"
  elif [ -n "$stdout" ]; then
    send "$(printf '%s' "$stdout" | jq -Rsc '{type:"output",text:.}')"
  else
    if [ "$format" = "json" ]; then
      send_output "[]"
    else
      send_output "(no results)"
    fi
  fi
}

cmd_schema() {
  local db_path=""
  local format="text"
  local i=1
  while [ $i -lt ${#ARGV[@]} ]; do
    case "${ARGV[$i]}" in
      --path) i=$((i + 1)); db_path="${ARGV[$i]:-}" ;;
      --json) format="json" ;;
    esac
    i=$((i + 1))
  done

  if [ -z "$db_path" ]; then
    db_path=$(get_db_path)
  elif [[ "$db_path" != /* ]]; then
    db_path="$PROJECT_ROOT/$db_path"
  fi
  if [ -z "$db_path" ]; then
    send_error "No database initialized. Run: fledge sql init"
    exit 1
  fi

  local sql_query
  if [ "$format" = "json" ]; then
    sql_query="SELECT json_group_array(json_object('type',type,'name',name,'sql',sql)) FROM sqlite_master WHERE type IN ('table','index','view') AND sql IS NOT NULL ORDER BY name;"
  else
    sql_query="SELECT sql FROM sqlite_master WHERE type IN ('table','index','view') AND sql IS NOT NULL ORDER BY name;"
  fi

  local result
  local safe_sql_query
  safe_sql_query=$(printf '%q' "$sql_query")
  result=$(send_exec "schema" "printf '%s' $safe_sql_query | sqlite3 '$db_path'" "$PROJECT_ROOT")
  local exit_code
  exit_code=$(resp_code "$result")

  if [ "$exit_code" != "0" ]; then
    local stderr
    stderr=$(resp_stderr "$result")
    send_error "Schema dump failed: $stderr"
    exit 1
  fi

  local stdout
  stdout=$(resp_stdout "$result")
  if [ -n "$stdout" ]; then
    send "$(printf '%s' "$stdout" | jq -Rsc '{type:"output",text:.}')"
  else
    send_output "(empty database)"
  fi
}

cmd_help() {
  send_output "fledge-plugin-sql — SQLite database management"
  send_output ""
  send_output "Commands:"
  send_output "  init [--path <db>]                           Create a project database"
  send_output "  migrate [--dir <dir>]                        Run SQL migrations"
  send_output "  query [--path <db>] [--json|--list|--csv] [--allow-destructive]"
  send_output "        [--param name=value]... <sql>           Execute a query"
  send_output "  schema [--path <db>] [--json]                Dump database schema"
}

cmd_version() {
  local script_dir
  script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  local plugin_toml="$script_dir/../plugin.toml"
  local version
  version=$(grep '^version' "$plugin_toml" 2>/dev/null | head -1 | sed 's/^version[[:space:]]*=[[:space:]]*"\(.*\)"/\1/')
  if [ -z "$version" ]; then
    version="unknown"
  fi
  send_output "fledge-plugin-sql $version"
}

case "$SUBCMD" in
  init)    cmd_init ;;
  migrate) cmd_migrate ;;
  query)   cmd_query ;;
  schema)  cmd_schema ;;
  help|--help|-h) cmd_help ;;
  version|--version|-V) cmd_version ;;
  *)
    send_output "Unknown command: $SUBCMD. Run: fledge sql help"
    exit 1
    ;;
esac
